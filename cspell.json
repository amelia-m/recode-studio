{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "ignorePaths": [
    "renv/library/**",
    "renv/staging/**",
    "renv.lock",
    "renv/activate.R",
    ".git/**",
    "inst/extdata/*.csv",
    "recodes_master.csv",
    "recat_*.csv",
    "recode_*.R",
    "cspell.json",
    "ext/**",
    "docs/superpowers/**",
    ".cspell/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "recode-studio-example-typos",
      "path": "./.cspell/example-typos.txt",
      "description": "Deliberate misspellings used as examples in docs and docstrings. See the file header before editing.",
      "addWords": false
    },
    {
      "name": "recode-studio-project",
      "path": "./dictionary/custom_terms.txt",
      "description": "Tier 2, project-shared terms (committed). Written by the app's 'Add to dictionary -> Project' button.",
      "addWords": false
    },
    {
      "name": "recode-studio-seed",
      "path": "./dictionary/seed_terms.txt",
      "description": "Tier 1 seed terms. Ships empty by design - this app is dataset-agnostic.",
      "addWords": false
    },
    {
      "name": "discipline-medical",
      "path": "./dictionary/disciplines/medical.txt",
      "addWords": false
    },
    {
      "name": "discipline-public-health",
      "path": "./dictionary/disciplines/public_health.txt",
      "addWords": false
    },
    {
      "name": "discipline-public-policy",
      "path": "./dictionary/disciplines/public_policy.txt",
      "addWords": false
    },
    {
      "name": "discipline-education",
      "path": "./dictionary/disciplines/education.txt",
      "addWords": false
    }
  ],
  "dictionaries": [
    "recode-studio-example-typos",
    "recode-studio-project",
    "recode-studio-seed"
  ],
  "overrides": [
    {
      "filename": "dictionary/**",
      "dictionaries": [
        "discipline-medical",
        "discipline-public-health",
        "discipline-public-policy",
        "discipline-education"
      ]
    }
  ],
